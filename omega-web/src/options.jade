doctype html
html(lang='zh-CN' ng-controller='MasterCtrl' ng-csp)
  head
    meta(charset='utf-8')
    title {{'options_title' | tr}} (网罗代理)
    meta(name='viewport' content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no')
    link(rel='stylesheet' href='lib/bootstrap/css/bootstrap.min.css')
    link(rel='stylesheet' href='lib/spectrum/spectrum.css')
    link(rel='stylesheet' href='lib/ladda/ladda-themeless.min.css')
    link(rel='stylesheet' href='lib/shepherd.js/shepherd-theme-arrows.css')
    link(rel='icon' type='image/png' href='img/icons/network-action-32.png')
    style.om-style
      {{customCss}}
    link(rel='stylesheet' href='css/options.css')
  body.app-body.app-body-stacked(style='display: none;' ng-style='{display: options ? "block" : "none"}')
    .app-main
      main.angular-animate
        .options-topbar
          .topbar-brand
            img.topbar-logo(src='img/icons/network-action-32.png' alt='')
            span.topbar-title 网罗代理
          .topbar-actions
            a.btn.btn-sm.btn-default(ui-sref='default')
              span.glyphicon.glyphicon-list
              = ' '
              | {{'options_navHeader_profiles' | tr}}
            a.btn.btn-sm.btn-default(ui-sref='ui')
              span.glyphicon.glyphicon-wrench
              = ' '
              | {{'options_tab_ui' | tr}}
            a.btn.btn-sm.btn-default(ui-sref='general')
              span.glyphicon.glyphicon-cog
              = ' '
              | {{'options_tab_general' | tr}}
            a.btn.btn-sm.btn-default(ui-sref='io')
              span.glyphicon.glyphicon-floppy-save
              = ' '
              | {{'options_tab_importExport' | tr}}
            span(ng-show='optionsDirty')
              a.btn.btn-sm.btn-success(ng-click='applyOptions()')
                span.glyphicon.glyphicon-ok-circle
                = ' '
                | {{'options_apply' | tr}}
              a.btn.btn-sm.btn-link.text-danger(ng-click='revertOptions()')
                span.glyphicon.glyphicon-remove-circle
                = ' '
                | {{'options_discard' | tr}}
        section.options-section(ng-show="$state.includes('ui')")
          include partials/ui
        section.options-section(ng-show="$state.includes('general')")
          include partials/general
        section.options-section(ng-show="$state.includes('io')" ng-controller='IoCtrl')
          include partials/io
        section.options-section(ng-show="$state.includes('default')")
          include partials/profile_list
        section.options-section(ng-show="$state.includes('profile')" ng-controller='ProfileCtrl')
          include partials/profile

    .alert-top-wrapper(ng-show='alertShown')
      div(alert type='workaround' close='hideAlert()'
          class='{{alertClassForType(alert.type)}}')
        span.glyphicon(class="{{alertIcons[alert.type]}}")
        = ' '
        | {{alert.i18n ? (alert.i18n | tr) : alert.message}}
    script(src='lib/zero-dependencies/moment/moment-with-locales.js')
    script(src='lib/zero-dependencies/idb-keyval/idb-keyval.js')
    script(src='lib/zero-dependencies/jszip/jszip.min.js')
    script(src='js/network_debug.js')
    script(src='js/log_error.js')
    script(src='lib/script.js/script.min.js')
    script(src='js/options.js')
